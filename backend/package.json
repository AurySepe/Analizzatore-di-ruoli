{
  "name": "analizzatore-di-ruoli",
  "version": "1.0.0",
  "description": "Backend NestJS per ricerca, analisi e archiviazione persistente di annunci di lavoro",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:api": "nest start",
    "start:extractor": "npx ts-node src/apps/extractor-worker/main.ts",
    "start:evaluator": "npx ts-node src/apps/evaluator-worker/main.ts",
    "start:curriculum": "npx ts-node src/apps/curriculum-worker/main.ts",
    "start:dev": "npx ts-node-dev --watch src/apps/api src/apps/api/main.ts",
    "start:dev:api": "npx ts-node-dev --watch src/apps/api src/apps/api/main.ts",
    "start:dev:extractor": "npx ts-node-dev --watch src/apps/extractor-worker src/apps/extractor-worker/main.ts",
    "start:dev:evaluator": "npx ts-node-dev --watch src/apps/evaluator-worker src/apps/evaluator-worker/main.ts",
    "start:dev:curriculum": "npx ts-node-dev --watch src/apps/curriculum-worker src/apps/curriculum-worker/main.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/apps/api/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:reset-jobs": "npx ts-node scripts/reset-extracted-data.ts",
    "db:reset-evaluations": "npx ts-node scripts/reset-evaluations.ts",
    "db:reset-curriculums": "npx ts-node scripts/reset-curriculums.ts",
    "db:reset-unanalyzable": "npx ts-node scripts/reset-unanalyzable-evaluations.ts",
    "db:restore": "npx ts-node scripts/restore-backup.ts",
    "startAndMigrate": "prisma migrate deploy && node dist/src/apps/api/main"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.0.0",
    "@types/turndown": "^5.0.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "denque": "^2.1.0",
    "dotenv": "^16.4.5",
    "ollama": "^0.6.3",
    "pg": "^8.22.0",
    "puppeteer": "^25.4.0",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.1",
    "turndown": "^7.2.4",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
