{
  "openapi": "3.0.0",
  "paths": {
    "/job-offers": {
      "post": {
        "operationId": "JobOffersController_create",
        "summary": "Crea o aggiorna un annuncio di lavoro",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobOfferDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOfferDto"
                }
              }
            }
          }
        },
        "tags": [
          "job-offers"
        ]
      }
    },
    "/job-offers/paginated": {
      "get": {
        "operationId": "JobOffersController_findAllPaginated",
        "summary": "Recupera la lista paginata e filtrata degli annunci di lavoro (con punteggi AI)",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "default": 1,
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "default": 10,
              "type": "integer"
            }
          },
          {
            "name": "priority",
            "required": false,
            "in": "query",
            "description": "Filtra per priorità AI: HIGH, MEDIUM, LOW, DISQUALIFIED",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minDesireScore",
            "required": false,
            "in": "query",
            "description": "Filtra per punteggio minimo aderenza ai desiderata (0-100)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "minCompetenceScore",
            "required": false,
            "in": "query",
            "description": "Filtra per punteggio minimo competenza tecnica (0-100)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "minScore",
            "required": false,
            "in": "query",
            "description": "Filtra per punteggio globale minimo (0-100)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "remoteType",
            "required": false,
            "in": "query",
            "description": "Filtra per modalità di lavoro (REMOTE, HYBRID, ON_SITE)",
            "schema": {
              "enum": [
                "REMOTE",
                "HYBRID",
                "ON_SITE",
                "UNSPECIFIED"
              ],
              "type": "string"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Cerca per testo nel titolo o nel nome azienda",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "required": false,
            "in": "query",
            "description": "Filtra per fonte dell annuncio (ARBEITNOW, REMOTIVE)",
            "schema": {
              "enum": [
                "ARBEITNOW",
                "REMOTIVE"
              ],
              "type": "string"
            }
          },
          {
            "name": "evaluatorModel",
            "required": false,
            "in": "query",
            "description": "Filtra per modello AI utilizzato per l analisi (es. GEMINI_3_1_FLASH_LITE, GEMMA_4_12B)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includePending",
            "required": false,
            "in": "query",
            "description": "Includi anche gli annunci non ancora valutati dall AI (default: false)",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/JobOfferDto"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginatedMetaDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "job-offers"
        ]
      }
    },
    "/job-offers/{id}": {
      "get": {
        "operationId": "JobOffersController_findOne",
        "summary": "Recupera un singolo annuncio di lavoro tramite ID",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "job-offers"
        ]
      }
    },
    "/evaluations/status": {
      "get": {
        "operationId": "EvaluationsController_getStatus",
        "summary": "Restituisce le metriche in tempo reale sullo stato di categorizzazione degli annunci",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Evaluations"
        ]
      }
    },
    "/evaluations": {
      "get": {
        "operationId": "EvaluationsController_findAll",
        "summary": "Recupera tutte le valutazioni salvate, filtrate per priorità o punteggio minimo",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Evaluations"
        ]
      }
    },
    "/evaluations/{jobOfferId}": {
      "get": {
        "operationId": "EvaluationsController_findOne",
        "summary": "Recupera la valutazione salvata per una specifica offerta",
        "parameters": [
          {
            "name": "jobOfferId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Evaluations"
        ]
      }
    }
  },
  "info": {
    "title": "Analizzatore di Ruoli & Job Aggregator API",
    "description": "API Gateway per la ricerca, estrazione e gestione degli annunci di lavoro",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "job-offers",
      "description": "Gestione e consultazione degli annunci di lavoro"
    },
    {
      "name": "Evaluations",
      "description": "Consultazione valutazioni AI"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "websiteUrl": {
            "type": "object",
            "nullable": true
          },
          "linkedinUrl": {
            "type": "object",
            "nullable": true
          },
          "industry": {
            "type": "object",
            "nullable": true
          },
          "fundingStage": {
            "type": "object",
            "nullable": true
          },
          "companySizeRange": {
            "type": "object",
            "nullable": true
          },
          "employeeCount": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateJobOfferDto": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "object",
            "nullable": true
          },
          "source": {
            "type": "string",
            "enum": [
              "ARBEITNOW",
              "REMOTIVE"
            ]
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "nullable": true
          },
          "remoteType": {
            "type": "string",
            "enum": [
              "REMOTE",
              "HYBRID",
              "ON_SITE",
              "UNSPECIFIED"
            ],
            "default": "UNSPECIFIED"
          },
          "rawDescription": {
            "type": "string"
          },
          "descriptionMarkdown": {
            "type": "object",
            "nullable": true
          },
          "datePosted": {
            "type": "object",
            "nullable": true
          },
          "salaryMin": {
            "type": "object",
            "nullable": true
          },
          "salaryMax": {
            "type": "object",
            "nullable": true
          },
          "currency": {
            "type": "object",
            "nullable": true,
            "default": "EUR"
          },
          "contractType": {
            "type": "object",
            "nullable": true
          },
          "roleCategory": {
            "type": "object",
            "nullable": true
          },
          "experienceLevel": {
            "type": "string",
            "enum": [
              "ENTRY_LEVEL",
              "JUNIOR",
              "MID",
              "SENIOR",
              "LEAD",
              "EXECUTIVE",
              "UNSPECIFIED"
            ],
            "default": "UNSPECIFIED"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "NEW",
              "SAVED",
              "APPLIED",
              "INTERVIEWING",
              "REJECTED",
              "ARCHIVED"
            ],
            "default": "NEW"
          },
          "notes": {
            "type": "object",
            "nullable": true
          },
          "company": {
            "$ref": "#/components/schemas/CreateCompanyDto"
          }
        },
        "required": [
          "source",
          "url",
          "title",
          "remoteType",
          "rawDescription",
          "experienceLevel",
          "status",
          "company"
        ]
      },
      "CompanyDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "websiteUrl": {
            "type": "object",
            "nullable": true
          },
          "linkedinUrl": {
            "type": "object",
            "nullable": true
          },
          "industry": {
            "type": "object",
            "nullable": true
          },
          "fundingStage": {
            "type": "object",
            "nullable": true
          },
          "companySizeRange": {
            "type": "object",
            "nullable": true
          },
          "employeeCount": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "JobEvaluationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "jobOfferId": {
            "type": "string"
          },
          "desireMatchScore": {
            "type": "number",
            "description": "Punteggio di aderenza ai desiderata dell utente (0-100)"
          },
          "competenceScore": {
            "type": "number",
            "description": "Punteggio di competenza tecnica (0-100)"
          },
          "overallScore": {
            "type": "number",
            "description": "Punteggio globale bilanciato (0-100)"
          },
          "priority": {
            "type": "string",
            "description": "Livello di priorità: HIGH, MEDIUM, LOW, DISQUALIFIED"
          },
          "status": {
            "type": "string",
            "description": "Stato dell analisi: SUCCESS | UNANALYZABLE"
          },
          "evaluatorModel": {
            "type": "string",
            "description": "Modello AI che ha analizzato l annuncio: GEMINI_3_1_FLASH_LITE | GEMMA_4_12B | UNKNOWN"
          },
          "desireMatchReasoning": {
            "type": "object",
            "description": "Spiegazione sintetico aderenza desiderata",
            "nullable": true
          },
          "competenceMatch": {
            "type": "string",
            "description": "Valutazione delle competenze dell utente rispetto al ruolo"
          },
          "detailedReasoning": {
            "type": "string",
            "description": "Spiegazione dettagliata dell AI in Markdown"
          },
          "pros": {
            "nullable": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cons": {
            "nullable": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "jobOfferId",
          "desireMatchScore",
          "competenceScore",
          "overallScore",
          "priority",
          "status",
          "evaluatorModel",
          "competenceMatch",
          "detailedReasoning",
          "createdAt",
          "updatedAt"
        ]
      },
      "JobOfferDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "externalId": {
            "type": "object",
            "nullable": true
          },
          "source": {
            "type": "string",
            "enum": [
              "ARBEITNOW",
              "REMOTIVE"
            ]
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "nullable": true
          },
          "remoteType": {
            "type": "string",
            "enum": [
              "REMOTE",
              "HYBRID",
              "ON_SITE",
              "UNSPECIFIED"
            ],
            "default": "UNSPECIFIED"
          },
          "rawDescription": {
            "type": "string"
          },
          "descriptionMarkdown": {
            "type": "object",
            "nullable": true
          },
          "datePosted": {
            "type": "object",
            "nullable": true
          },
          "company": {
            "$ref": "#/components/schemas/CompanyDto"
          },
          "salaryMin": {
            "type": "object",
            "nullable": true
          },
          "salaryMax": {
            "type": "object",
            "nullable": true
          },
          "currency": {
            "type": "object",
            "nullable": true,
            "default": "EUR"
          },
          "contractType": {
            "type": "object",
            "nullable": true
          },
          "roleCategory": {
            "type": "object",
            "nullable": true
          },
          "experienceLevel": {
            "type": "string",
            "enum": [
              "ENTRY_LEVEL",
              "JUNIOR",
              "MID",
              "SENIOR",
              "LEAD",
              "EXECUTIVE",
              "UNSPECIFIED"
            ],
            "default": "UNSPECIFIED"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "NEW",
              "SAVED",
              "APPLIED",
              "INTERVIEWING",
              "REJECTED",
              "ARCHIVED"
            ],
            "default": "NEW"
          },
          "notes": {
            "type": "object",
            "nullable": true
          },
          "evaluation": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/JobEvaluationDto"
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "url",
          "title",
          "remoteType",
          "rawDescription",
          "company",
          "experienceLevel",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "PaginatedMetaDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        },
        "required": [
          "total",
          "page",
          "limit",
          "totalPages"
        ]
      }
    }
  }
}