  "paths": {
    "/job-offers": {
      "post": {
        "operationId": "JobOffersController_create",
        "summary": "Crea o aggiorna un annuncio di lavoro nel database",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobOfferDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOfferDto"
                }
              }
            }
          }
        },
        "tags": [
          "job-offers"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/job-offers/paginated": {
      "get": {
        "operationId": "JobOffersController_findAllPaginated",
        "summary": "Recupera la lista paginata degli annunci di lavoro",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/JobOfferDto"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/PaginatedMetaDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "job-offers"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/job-offers/{id}": {
      "get": {
        "operationId": "JobOffersController_findOne",
        "summary": "Recupera un singolo annuncio di lavoro tramite ID",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
