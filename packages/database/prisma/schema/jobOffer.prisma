model JobOffer {
  id              String            @id @default(uuid())
  externalId      String?
  source          JobSource
  url             String            @unique

  
  // Offer details
  title           String
  location        String?
  remoteType      RemoteType        @default(UNSPECIFIED)
  rawDescription  String
  descriptionMarkdown String?
  datePosted      DateTime?
  
  // Company relation
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  
  // Compensation & Contract
  salaryMin       Float?
  salaryMax       Float?
  currency        String?           @default("EUR")
  contractType    String?
  
  // Profile & Requirements
  roleCategory    String?
  experienceLevel ExperienceLevel   @default(UNSPECIFIED)
  skills          String?           // JSON string array (e.g. '["TypeScript","Node.js"]')

  // Tracking
  status          ApplicationStatus @default(NEW)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  evaluation      JobEvaluation?
  curriculum      JobCurriculum?
  statusHistory   JobStatusHistory[]

  @@unique([source, externalId])
  @@index([companyId])
  @@index([source])
  @@index([status])
}

model JobStatusHistory {
  id          String            @id @default(uuid())
  jobOfferId  String
  jobOffer    JobOffer          @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  fromStatus  ApplicationStatus?
  toStatus    ApplicationStatus
  createdAt   DateTime          @default(now())

  @@index([jobOfferId])
}
