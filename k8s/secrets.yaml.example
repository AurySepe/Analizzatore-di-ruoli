apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  labels:
    app.kubernetes.io/name: app-secrets
    app.kubernetes.io/part-of: analizzatore-di-ruoli
type: Opaque
stringData:
  # Database Credentials
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "your-postgres-password"
  POSTGRES_DB: "analizzatore_ruoli"

  # MinIO / Object Storage Credentials
  MINIO_ROOT_USER: "minioadmin"
  MINIO_ROOT_PASSWORD: "your-minio-password"
  S3_ACCESS_KEY: "minioadmin"
  S3_SECRET_KEY: "your-minio-password"

  # AI Provider API Keys
  GEMINI_API_KEY: "your-gemini-api-key"
  CURRICULUM_GEMINI_API_KEY: "your-gemini-api-key"
