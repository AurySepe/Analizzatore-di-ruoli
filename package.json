{
  "name": "analizzatore-di-ruoli-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "services/extractors/*",
    "frontend"
  ],
  "scripts": {
    "sync:api": "npm --prefix services/api run openapi:generate && npm --prefix frontend run openapi:generate",
    "build:all": "npm --prefix packages/contracts run build && npm --prefix services/api run build && npm --prefix frontend run build",
    "api:dev": "npm --prefix services/api run start:dev",
    "api:build": "npm --prefix services/api run build",
    "api:prisma:generate": "npm --prefix services/api run prisma:generate",
    "api:prisma:migrate": "npm --prefix services/api run prisma:migrate:dev",
    "api:prisma:studio": "npm --prefix services/api run prisma:studio",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "frontend:lint": "npm --prefix frontend run lint",
    "k8s:deploy": "node scripts/deploy-k8s.mjs",
    "k8s:deploy:api": "node scripts/deploy-k8s.mjs --service=api",
    "k8s:deploy:frontend": "node scripts/deploy-k8s.mjs --frontend-only",
    "k8s:restart": "kubectl rollout restart deployment backend-api backend-curriculum backend-evaluator worker-ingestion extractor-arbeitnow extractor-remotive extractor-jobicy extractor-weworkremotely frontend",
    "k8s:status": "kubectl get pods,svc,ingress",
    "k8s:logs:api": "kubectl logs -f deployment/backend-api",
    "k8s:logs:curriculum": "kubectl logs -f deployment/backend-curriculum",
    "k8s:logs:evaluator": "kubectl logs -f deployment/backend-evaluator",
    "k8s:logs:ingestion": "kubectl logs -f deployment/worker-ingestion",
    "cluster:create": "k3d cluster create --config k3d.config.yaml",
    "cluster:delete": "k3d cluster delete analizzatore-cluster",
    "cluster:start": "k3d cluster start analizzatore-cluster",
    "cluster:stop": "k3d cluster stop analizzatore-cluster"
  }
}
