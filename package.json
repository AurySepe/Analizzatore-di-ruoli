{
  "name": "analizzatore-di-ruoli-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "services/extractors/*",
    "frontend"
  ],
  "scripts": {
    "db:migrate:new": "node scripts/db-migration.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "preflight": "node scripts/deploy-k8s.mjs --preflight-only",
    "sync:api": "pnpm --filter @analizzatore/api run openapi:generate && pnpm --filter analizzatore-di-ruoli-frontend run openapi:generate",
    "build:all": "pnpm --filter @analizzatore/contracts run build && pnpm --filter @analizzatore/api run build && pnpm --filter analizzatore-di-ruoli-frontend run build",
    "api:dev": "pnpm --filter @analizzatore/api run start:dev",
    "api:build": "pnpm --filter @analizzatore/api run build",
    "api:prisma:generate": "pnpm --filter @analizzatore/api run prisma:generate",
    "api:prisma:migrate": "pnpm --filter @analizzatore/api run prisma:migrate:dev",
    "api:prisma:studio": "pnpm --filter @analizzatore/api run prisma:studio",
    "frontend:dev": "pnpm --filter analizzatore-di-ruoli-frontend run dev",
    "frontend:build": "pnpm --filter analizzatore-di-ruoli-frontend run build",
    "frontend:typecheck": "pnpm --filter analizzatore-di-ruoli-frontend run typecheck",
    "frontend:lint": "pnpm --filter analizzatore-di-ruoli-frontend run lint",
    "k8s:deploy": "node scripts/deploy-k8s.mjs",
    "k8s:deploy:api": "node scripts/deploy-k8s.mjs --service=api",
    "k8s:deploy:frontend": "node scripts/deploy-k8s.mjs --frontend-only",
    "k8s:deploy:api-frontend": "node scripts/deploy-k8s.mjs --service=api,frontend",
    "k8s:restart": "kubectl rollout restart deployment backend-api relay-curriculum relay-evaluation backend-curriculum backend-pdf backend-evaluator worker-ingestion extractor-arbeitnow extractor-remotive extractor-jobicy extractor-weworkremotely frontend",
    "k8s:status": "kubectl get pods,svc,ingress",
    "k8s:logs:api": "kubectl logs -f deployment/backend-api",
    "k8s:logs:curriculum": "kubectl logs -f deployment/backend-curriculum",
    "k8s:logs:pdf": "kubectl logs -f deployment/backend-pdf",
    "k8s:logs:evaluator": "kubectl logs -f deployment/backend-evaluator",
    "k8s:logs:ingestion": "kubectl logs -f deployment/worker-ingestion",
    "k8s:logs:relay:curriculum": "kubectl logs -f deployment/relay-curriculum",
    "k8s:logs:relay:evaluation": "kubectl logs -f deployment/relay-evaluation",
    "cluster:create": "k3d cluster create --config k3d.config.yaml",
    "cluster:delete": "k3d cluster delete analizzatore-cluster",
    "cluster:start": "k3d cluster start analizzatore-cluster",
    "cluster:stop": "k3d cluster stop analizzatore-cluster"
  }
}
