generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model WeWorkRemotelyScrapedJob {
  id                  String       @id @default(uuid())
  externalId          String       @unique
  url                 String       @unique
  title               String
  companyName         String
  location            String?
  remoteType          String?      @default("REMOTE")
  salaryMin           Float?
  salaryMax           Float?
  currency            String?
  contractType        String?
  rawDescription      String       @db.Text
  descriptionMarkdown String?      @db.Text
  datePosted          DateTime?
  tags                String?      @db.Text

  // Outbox Pattern Fields
  outboxStatus        OutboxStatus @default(PENDING)
  publishedAt         DateTime?
  retryCount          Int          @default(0)
  lastError           String?      @db.Text

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([outboxStatus])
  @@index([createdAt])
  @@map("weworkremotely_scraped_jobs")
}

model WeWorkRemotelySyncState {
  id             String    @id @default(uuid())
  source         String    @unique @default("WEWORKREMOTELY")
  lastSyncAt     DateTime?
  lastSuccessfulSyncAt DateTime?
  itemsExtracted Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("weworkremotely_sync_states")
}
