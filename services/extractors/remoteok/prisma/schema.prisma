generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model RemoteokScrapedJob {
  id                  String       @id @default(uuid())
  externalId          String       @unique
  url                 String       @unique
  slug                String?
  title               String
  companyName         String
  location            String?
  remoteType          String?      @default("REMOTE")
  salaryMin           Float?
  salaryMax           Float?
  currency            String?      @default("USD")
  contractType        String?
  rawDescription      String       @db.Text
  descriptionMarkdown String?      @db.Text
  datePosted          DateTime?
  tags                String?      @db.Text

  // Outbox Pattern Fields
  outboxStatus        OutboxStatus @default(PENDING)
  publishedAt         DateTime?
  retryCount          Int          @default(0)
  lastError           String?      @db.Text

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([outboxStatus])
  @@index([createdAt])
  @@map("remoteok_scraped_jobs")
}

model RemoteokSyncState {
  id                   String    @id @default(uuid())
  source               String    @unique @default("REMOTEOK")
  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  itemsExtracted       Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("remoteok_sync_states")
}
