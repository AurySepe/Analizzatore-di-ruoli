model Company {
  id               String     @id @default(uuid())
  name             String     @unique
  websiteUrl       String?
  linkedinUrl      String?
  industry         String?
  
  // Funding & Size
  fundingStage     String?
  companySizeRange String?
  employeeCount    Int?
  
  jobOffers        JobOffer[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}
